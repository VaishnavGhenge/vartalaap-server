# Local development overrides.
# Copy this to .env.local — run.sh sources it after .env so these values win.
#
# Purpose: stop local dev from hitting production services (Resend, Sentry).
# Mailpit (docker compose up -d mailpit) catches all outbound email at
# http://localhost:8025 so you can inspect HTML templates without real delivery.

# Unset Resend so the email stack falls back to Mailpit SMTP below.
RESEND_API_KEY=

# Mailpit SMTP — matches the port in docker-compose.yml.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Sessionly <notifications@sessionly.local>

# Plain HTTP cookies work on localhost; prod needs true.
SECURE_COOKIE=false
