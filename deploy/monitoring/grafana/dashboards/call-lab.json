      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(vartalaap_call_attempts_total{result=~\"success|slow\"}[$__range])) / sum(increase(vartalaap_call_attempts_total{result=~\"success|slow|failed|error\"}[$__range]))",
          "legendFormat": "{{result}} {{stage}} {{rung}} {{outcome}} {{reason}} {{route}} {{status_class}} {{alertname}} {{alertstate}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vartalaap-prometheus"
