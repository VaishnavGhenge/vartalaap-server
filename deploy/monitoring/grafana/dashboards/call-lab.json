{
  "uid": "vartalaap-call-lab",
  "title": "Vartalaap call lab",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "vartalaap",
    "staging"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "How to read this call lab",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Staging only. Start a call, note its time, then select that time range here. No data means no observations, not zero failures. Success includes slow connections and excludes abandoned attempts. Browser RTT/loss/jitter are stream-report samples, weighted toward longer calls and larger rooms; they are not per-call percentiles. Video held is intentional quality adaptation, not measured video freezes. Alerts are evaluated in Prometheus; external notification delivery is not configured."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API scrape healthy",
      "datasource": {
        "type": "prometheus",
        "uid": "vartalaap-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"vartalaap-api\"}",
          "legendFormat": "{{result}} {{stage}} {{rung}} {{outcome}} {{reason}} {{route}} {{status_class}} {{alertname}} {{alertstate}}",
          "datasource": {
            "type": "prometheus",
            "uid": "vartalaap-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
